---
import { site } from '../data/site';
import Icon from './Icon.astro';

const nav = [
  { label: 'Services', href: '/#services' },
  { label: 'Why IV', href: '/#why' },
  { label: 'How It Works', href: '/#how-it-works' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="container-x">
    <div
      class="mt-3 flex items-center justify-between gap-4 rounded-2xl border border-white/5 bg-navy/70 px-4 py-2.5 backdrop-blur-xl transition-all duration-300 md:px-5"
      id="header-bar"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${site.name} — home`}>
        <img
          src="/assets/logo.svg"
          alt={site.name}
          width="150"
          height="48"
          class="h-10 w-auto md:h-11"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        />
        <span class="hidden items-baseline gap-1 font-display text-xl text-cream" aria-hidden="true">
          <span class="font-semibold text-teal">IV</span><span class="text-script text-2xl leading-none">Salt</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-mist transition-colors hover:text-cream"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2.5">
        <a href={site.phoneHref} class="hidden items-center gap-2 text-sm font-semibold text-mist transition-colors hover:text-teal-bright sm:flex" aria-label={`Call ${site.phone}`}>
          <Icon name="phone" size={17} class="text-teal" />
          <span class="hidden xl:inline">{site.phone}</span>
        </a>
        <a href="/book" class="btn btn-primary !px-4 !py-2.5 text-sm md:!px-5">Book Now</a>

        <!-- Mobile menu toggle -->
        <button
          id="menu-toggle"
          class="grid h-11 w-11 place-items-center rounded-xl border border-white/10 text-cream lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" size={22} />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
  >
    <div class="absolute inset-0 bg-ink/80 backdrop-blur-sm" data-close-menu></div>
    <nav class="absolute right-0 top-0 flex h-full w-[82%] max-w-sm flex-col gap-1 border-l border-white/10 bg-navy-800 px-6 pt-24 pb-8 shadow-2xl">
      <button
        class="absolute right-5 top-5 grid h-11 w-11 place-items-center rounded-xl border border-white/10 text-cream"
        aria-label="Close menu"
        data-close-menu
      >
        <Icon name="close" size={22} />
      </button>
      {nav.map((item) => (
        <a
          href={item.href}
          class="border-b border-white/5 py-4 font-display text-2xl text-cream transition-colors hover:text-teal-bright"
          data-close-menu
        >
          {item.label}
        </a>
      ))}
      <a href="/book" class="btn btn-primary mt-6 w-full" data-close-menu>Book Your Appointment</a>
      <a href={site.phoneHref} class="btn btn-ghost mt-3 w-full">
        <Icon name="phone" size={18} /> {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('header-bar');

  function openMenu() {
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  toggle?.addEventListener('click', openMenu);
  menu?.querySelectorAll('[data-close-menu]').forEach((el) => el.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) closeMenu();
  });

  // Solidify header on scroll
  const onScroll = () => {
    if (window.scrollY > 20) header?.classList.add('!bg-navy/90', 'shadow-xl', 'shadow-black/30');
    else header?.classList.remove('!bg-navy/90', 'shadow-xl', 'shadow-black/30');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
