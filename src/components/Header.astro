---
import { site } from '../data/site';
import Icon from './Icon.astro';

const nav = [
  { label: 'Services', href: '/#services' },
  { label: 'How It Works', href: '/#how-it-works' },
  { label: 'About', href: '/#about' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/#contact' },
];
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <!-- Announcement bar -->
  <div class="text-ink" style="background: var(--grad-brand);">
    <p class="container-x flex items-center justify-center gap-2 py-1.5 text-center text-[0.78rem] font-bold tracking-wide">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ink/40"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-ink"></span>
      </span>
      {site.announcement}
    </p>
  </div>
  <div class="container-x">
    <div
      class="mt-3 flex items-center justify-between gap-4 rounded-2xl border border-white/5 bg-navy/80 px-4 py-2.5 backdrop-blur-md transition-all duration-300 md:px-5"
      id="header-bar"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${site.name} — home`}>
        <img
          src="/assets/iv-salt-logo.png"
          alt={site.name}
          width="170"
          height="110"
          class="h-12 w-auto md:h-14"
          onerror="this.onerror=null;this.src='/assets/logo.svg'"
        />
        <span class="hidden items-baseline gap-1 font-display text-xl text-cream" aria-hidden="true">
          <span class="font-semibold text-teal">IV</span><span class="text-script text-2xl leading-none">Salt</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-mist transition-colors hover:text-cream"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2.5">
        <a href={site.phoneHref} class="hidden items-center gap-2 text-sm font-semibold text-mist transition-colors hover:text-teal-bright sm:flex" aria-label={`Call ${site.phone}`}>
          <Icon name="phone" size={17} class="text-teal" />
          <span class="hidden xl:inline">{site.phone}</span>
        </a>
        <a href="/book" class="btn btn-primary !px-4 !py-2.5 text-sm md:!px-5">Book Now</a>

        <!-- Mobile menu toggle (morphs between menu / close) -->
        <button
          id="menu-toggle"
          class="relative grid h-11 w-11 place-items-center rounded-xl border border-white/10 text-cream lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span data-icon-open><Icon name="menu" size={22} /></span>
          <span data-icon-close class="hidden"><Icon name="close" size={22} /></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu — sits ABOVE the header (z-60) so nothing overlaps; the panel
     carries its own logo + close button. -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="absolute inset-0 bg-ink/85 backdrop-blur-sm" data-close-menu></div>
  <nav class="absolute right-0 top-0 flex h-full w-[86%] max-w-sm flex-col border-l border-white/10 bg-navy-800 shadow-2xl">
    <!-- Panel top bar: logo + close -->
    <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
      <img src="/assets/iv-salt-logo.png" alt={site.name} width="130" height="84" class="h-11 w-auto"
        onerror="this.onerror=null;this.src='/assets/logo.svg'" />
      <button
        class="grid h-11 w-11 place-items-center rounded-xl border border-white/10 text-cream"
        aria-label="Close menu"
        data-close-menu
      >
        <Icon name="close" size={22} />
      </button>
    </div>

    <div class="flex flex-1 flex-col overflow-y-auto px-6 py-4">
      {nav.map((item) => (
        <a
          href={item.href}
          class="border-b border-white/5 py-4 font-display text-2xl text-cream transition-colors hover:text-teal-bright"
          data-close-menu
        >
          {item.label}
        </a>
      ))}
      <a href="/book" class="btn btn-primary mt-6 w-full" data-close-menu>Book Your Appointment</a>
      <a href={site.phoneHref} class="btn btn-ghost mt-3 w-full">
        <Icon name="phone" size={18} /> {site.phone}
      </a>
    </div>
  </nav>
</div>

<script>
  function initHeaderMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const header = document.getElementById('header-bar');
    if (!toggle || !menu || toggle.dataset.bound) return;
    toggle.dataset.bound = 'true';

    const iconOpen = toggle.querySelector('[data-icon-open]');
    const iconClose = toggle.querySelector('[data-icon-close]');

    const isOpen = () => !menu.classList.contains('hidden');
    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    menu.querySelectorAll('[data-close-menu]').forEach((el) =>
      el.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });

    // Solidify header on scroll
    const onScroll = () => {
      if (window.scrollY > 20) header?.classList.add('!bg-navy/90', 'shadow-xl', 'shadow-black/30');
      else header?.classList.remove('!bg-navy/90', 'shadow-xl', 'shadow-black/30');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  initHeaderMenu();
  // Re-bind if the DOM is swapped (defensive; e.g. future view transitions)
  document.addEventListener('astro:page-load', initHeaderMenu);
</script>
