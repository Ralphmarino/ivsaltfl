---
import { site } from '../../data/site';
import Icon from '../Icon.astro';

// Keyless Google Maps embed (no API key required) centered on the service area.
const embedSrc = 'https://www.google.com/maps?q=Martin+County,+Florida&z=9&output=embed';
const directionsHref = 'https://www.google.com/maps/place/Martin+County,+FL';
---

<section id="service-area" class="relative scroll-mt-28 py-20 md:py-24">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div data-reveal>
        <p class="eyebrow">Where We Come To You</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl">Serving the <span class="text-gradient">Treasure Coast</span></h2>
        <p class="mt-4 max-w-md text-mist">
          We bring premium IV therapy right to your door across Martin County and the surrounding Treasure Coast.
        </p>
        <div class="mt-6">
          <p class="text-sm font-semibold text-cream">No travel fee in:</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {site.noFeeCities.map((c) => (
              <li class="flex items-center gap-1.5 rounded-full border border-teal/25 bg-teal/5 px-3 py-1.5 text-sm text-mist">
                <Icon name="map-pin" size={14} class="text-teal-bright" /> {c}
              </li>
            ))}
          </ul>
          <p class="mt-3 text-sm text-mist-dim">
            Extended areas may include a small travel fee, always disclosed before your appointment is confirmed.
          </p>
        </div>
        <a href="/book" class="btn btn-teal mt-7">Book Your Visit <Icon name="arrow-right" size={18} /></a>
      </div>

      <!-- Map with click-to-load facade (keeps Google off the page until requested — faster + more private) -->
      <div class="card relative aspect-[16/11] w-full overflow-hidden rounded-[1.5rem]" data-reveal data-reveal-delay="1">
        <div id="map-facade" class="absolute inset-0 grid place-items-center bg-gradient-to-br from-navy-800 to-ink">
          <div class="aurora opacity-60"></div>
          <div class="relative z-10 text-center">
            <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-gradient-to-br from-teal to-pink text-white animate-pulse-glow">
              <Icon name="map-pin" size={30} />
            </span>
            <p class="mt-4 font-display text-xl text-cream">Martin County &amp; the Treasure Coast</p>
            <button
              id="map-load"
              class="btn btn-ghost mt-4 !py-2.5 text-sm"
              aria-label="Load interactive Google map of the service area"
            >
              View interactive map
            </button>
            <p class="mt-3 text-xs text-mist-dim">
              or <a href={directionsHref} target="_blank" rel="noopener noreferrer" class="text-teal-bright underline">open in Google Maps</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ embedSrc }}>
  const btn = document.getElementById('map-load');
  const facade = document.getElementById('map-facade');
  btn?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = embedSrc;
    iframe.title = 'Map of the IV Salt Rejuvenation service area';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    iframe.setAttribute('allowfullscreen', '');
    facade?.replaceWith(iframe);
  });
</script>
