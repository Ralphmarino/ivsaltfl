---
/**
 * Inline SVG icon set. Renders by `name`. Decorative by default
 * (aria-hidden); pass `title` to expose an accessible label.
 */
interface Props {
  name: string;
  class?: string;
  size?: number | string;
  title?: string;
}
const { name, class: className = '', size = 24, title } = Astro.props;
const a11y = title
  ? { role: 'img', 'aria-label': title }
  : { 'aria-hidden': 'true', focusable: 'false' };
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  class: className,
  ...a11y,
};
---

