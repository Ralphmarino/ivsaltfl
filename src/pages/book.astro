---
import Base from '../layouts/Base.astro';
import BookingWizard from '../components/booking/BookingWizard.tsx';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base
  title="Book an Appointment"
  description="Book your mobile IV therapy on the Treasure Coast. Choose your infusion, add boosts, and reserve a time — a licensed RN comes to you."
  path="/book"
>
  <section class="relative overflow-hidden pt-36 pb-16 md:pt-44">
    <div class="aurora"></div>
    <div class="container-x relative z-10">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow eyebrow-center justify-center">Book Your Wellness</p>
        <h1 class="mt-4 font-display text-4xl md:text-5xl">
          Reserve your <span class="text-gradient">mobile IV session</span>
        </h1>
        <p class="mt-4 text-mist">
          It takes about two minutes. We'll follow up with a confirmation, a quick consent form, and a
          ${site.depositAmount} deposit to lock in your appointment.
        </p>
        <p class="mx-auto mt-4 inline-flex flex-wrap items-center justify-center gap-2 rounded-full border border-teal/25 bg-teal/5 px-4 py-2 text-sm text-mist">
          <Icon name="heart" size={15} class="text-teal-bright" />
          Booking for a group? Add up to {site.maxPartySize} guests at the “Your Details” step.
        </p>
      </div>
    </div>
  </section>

  <section class="relative pb-24">
    <div class="container-x">
      <BookingWizard client:load />
    </div>
  </section>
</Base>
