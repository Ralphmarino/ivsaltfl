---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { author, readingTime, formatDate } from '../../data/author';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(`/blog/${post.id}/`, Astro.site ?? site.url).href;
const readTime = readingTime(post.body ?? '');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.publishDate.toISOString(),
  dateModified: (d.updatedDate ?? d.publishDate).toISOString(),
  author: d.authorOrg
    ? { '@type': 'Organization', name: site.name, url: site.url }
    : { '@type': 'Person', name: author.name },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  ...(d.reviewedBy
    ? { reviewedBy: { '@type': 'Person', name: d.reviewedBy, jobTitle: author.role } }
    : {}),
  mainEntityOfPage: url,
  articleSection: d.category,
  ...(d.heroImage ? { image: new URL(d.heroImage, Astro.site ?? site.url).href } : {}),
};

const faqLd = d.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base title={d.seoTitle ?? d.title} description={d.description} path={`/blog/${post.id}/`} image={d.heroImage ?? '/og-image.jpg'}>
  <article class="relative pt-32 pb-20 md:pt-40">
    <div class="aurora opacity-50"></div>
    <div class="container-x relative z-10">
      <div class="mx-auto max-w-3xl">
        <a href="/blog" class="text-sm text-teal-bright hover:text-teal">← All articles</a>

        <div class="mt-5 flex flex-wrap items-center gap-3 text-xs text-mist-dim">
          <span class="rounded-full border border-teal/25 bg-teal/5 px-3 py-1 font-bold uppercase tracking-wider text-teal-bright">{d.category}</span>
          <span>{formatDate(d.publishDate)}</span>
          <span aria-hidden="true">•</span>
          <span class="flex items-center gap-1"><Icon name="clock" size={13} /> {readTime}</span>
        </div>

        <h1 class="mt-4 font-display text-4xl leading-tight md:text-5xl">{d.title}</h1>
        <p class="mt-4 text-lg text-mist">{d.description}</p>

        <!-- Author -->
        <div class="mt-6 flex items-center gap-3 border-y border-white/8 py-4">
          <img
            src={author.image}
            alt={author.name}
            width="48"
            height="48"
            class="h-12 w-12 rounded-full object-cover"
            onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"
          />
          <span class="hidden h-12 w-12 place-items-center rounded-full bg-gradient-to-br from-pink to-gold font-display text-lg text-white" aria-hidden="true">S</span>
          <div>
            <p class="font-semibold text-cream">{author.name}</p>
            <p class="text-xs text-mist-dim">{author.role}</p>
            {d.byline && <p class="mt-1 text-xs text-mist-dim">{d.byline}</p>}
          </div>
        </div>

        {d.heroImage && (
          <img
            src={d.heroImage}
            alt={d.heroAlt ?? ''}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover"
            onerror="this.style.display='none'"
          />
        )}

        <!-- Body -->
        <div class="prose-blog mt-10">
          <Content />
        </div>

        <!-- FAQ -->
        {d.faqs && d.faqs.length > 0 && (
          <section class="mt-14">
            <h2 class="font-display text-3xl text-cream">Frequently asked questions</h2>
            <div class="mt-6 space-y-3">
              {d.faqs.map((f) => (
                <details class="faq-item card overflow-hidden rounded-2xl">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-lg text-cream">
                    <span>{f.q}</span>
                    <span class="faq-icon grid h-8 w-8 shrink-0 place-items-center rounded-full border border-white/12 text-teal-bright transition-transform duration-300"><Icon name="plus" size={18} /></span>
                  </summary>
                  <div class="px-5 pb-5 text-mist leading-relaxed">{f.a}</div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Author bio -->
        <div class="mt-14 flex flex-col items-center gap-4 rounded-2xl border border-white/8 bg-navy/40 p-6 text-center sm:flex-row sm:text-left">
          <img src={author.image} alt={author.name} width="64" height="64" class="h-16 w-16 rounded-full object-cover"
            onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
          <span class="hidden h-16 w-16 shrink-0 place-items-center rounded-full bg-gradient-to-br from-pink to-gold font-display text-2xl text-white" aria-hidden="true">S</span>
          <div>
            <p class="font-display text-lg text-cream">{author.name}</p>
            <p class="mt-1 text-sm text-mist">{author.bio}</p>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-2xl border border-gold/25 bg-gold/5 p-6 text-center">
          <p class="font-display text-2xl text-cream">Ready to feel your best?</p>
          <p class="mt-2 text-mist">Book a mobile IV session with a licensed RN, delivered to your door.</p>
          <a href="/book" class="btn btn-primary mt-5">Book Your Wellness <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</Base>

<style is:global>
  .prose-blog { color: var(--color-mist); line-height: 1.8; font-size: 1.05rem; }
  .prose-blog h2 { color: var(--color-cream); font-family: var(--font-display); font-size: 1.75rem; margin-top: 2.5rem; margin-bottom: 0.85rem; letter-spacing: -0.01em; }
  .prose-blog h3 { color: var(--color-cream); font-family: var(--font-display); font-size: 1.3rem; margin-top: 1.75rem; margin-bottom: 0.5rem; }
  .prose-blog p { margin-bottom: 1.15rem; }
  .prose-blog ul { margin: 0 0 1.15rem 1.25rem; list-style: disc; }
  .prose-blog ol { margin: 0 0 1.15rem 1.25rem; list-style: decimal; }
  .prose-blog li { margin-bottom: 0.5rem; padding-left: 0.25rem; }
  .prose-blog a { color: var(--color-teal-bright); text-decoration: underline; text-underline-offset: 3px; }
  .prose-blog a:hover { color: var(--color-teal); }
  .prose-blog strong { color: var(--color-cream); }
  .prose-blog blockquote { border-left: 3px solid var(--color-pink); padding-left: 1.1rem; margin: 1.5rem 0; color: var(--color-cream); font-style: italic; }
  .prose-blog code { background: rgba(255,255,255,0.06); padding: 0.1rem 0.4rem; border-radius: 0.35rem; font-size: 0.9em; }
  .prose-blog img { border-radius: 1rem; margin: 1.5rem 0; }
  /* GEO "Quick Answer" callout — a clean, quotable box for AI overviews. */
  .prose-blog .quick-answer { border: 1px solid rgba(41, 196, 214, 0.3); background: rgba(41, 196, 214, 0.07); border-radius: 1.1rem; padding: 1.25rem 1.5rem; margin: 1.75rem 0; }
  .prose-blog .quick-answer .qa-label { display: flex; align-items: center; gap: 0.5rem; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.7rem; font-weight: 700; color: var(--color-teal-bright); margin-bottom: 0.55rem; }
  .prose-blog .quick-answer .qa-label::before { content: ""; width: 0.55rem; height: 0.55rem; border-radius: 9999px; background: var(--color-teal-bright); box-shadow: 0 0 0 3px rgba(41, 196, 214, 0.2); }
  .prose-blog .quick-answer p { margin: 0; color: var(--color-cream); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); border-color: rgba(41, 196, 214, 0.5); }
  .faq-item[open] { border-color: rgba(41, 196, 214, 0.3); }
</style>
