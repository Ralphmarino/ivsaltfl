---
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  path: string;
  updated?: string;
  description?: string;
}
const { title, path, updated = 'July 2026', description } = Astro.props;
---

<Base title={title} description={description ?? `${title} — ${site.name}`} path={path}>
  <article class="relative pt-32 pb-20 md:pt-40">
    <div class="aurora opacity-50"></div>
    <div class="container-x relative z-10">
      <div class="mx-auto max-w-3xl">
        <a href="/" class="text-sm text-teal-bright hover:text-teal">← Back to home</a>
        <h1 class="mt-4 font-display text-4xl md:text-5xl text-cream">{title}</h1>
        <p class="mt-3 text-sm text-mist-dim">Last updated: {updated}</p>

        <div class="prose-legal mt-10">
          <slot />
        </div>

        <div class="mt-14 rounded-2xl border border-white/8 bg-navy/40 p-6 text-sm text-mist">
          <p class="font-display text-lg text-cream">Questions?</p>
          <p class="mt-2">
            Contact us at
            <a href={`mailto:${site.email}`} class="text-teal-bright hover:underline">{site.email}</a>
            or <a href={site.phoneHref} class="text-teal-bright hover:underline">{site.phone}</a>.
          </p>
        </div>
      </div>
    </div>
  </article>
</Base>

<style is:global>
  .prose-legal { color: var(--color-mist); line-height: 1.75; }
  .prose-legal h2 {
    color: var(--color-cream);
    font-size: 1.5rem;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .prose-legal h3 {
    color: var(--color-cream);
    font-size: 1.15rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-legal p { margin-bottom: 1rem; }
  .prose-legal ul { margin: 0 0 1rem 1.25rem; list-style: disc; }
  .prose-legal ol { margin: 0 0 1rem 1.25rem; list-style: decimal; }
  .prose-legal li { margin-bottom: 0.4rem; padding-left: 0.25rem; }
  .prose-legal a { color: var(--color-teal-bright); text-decoration: underline; text-underline-offset: 3px; }
  .prose-legal a:hover { color: var(--color-teal); }
  .prose-legal strong { color: var(--color-cream); }
  .prose-legal .callout {
    border: 1px solid rgba(233, 185, 106, 0.3);
    background: rgba(233, 185, 106, 0.06);
    border-radius: 1rem;
    padding: 1.1rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-mist);
  }
</style>
