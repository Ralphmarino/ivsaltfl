---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/manrope';
import '@fontsource/pinyon-script';
import '../styles/global.css';

import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  /** hide the marketing header/footer (e.g. focused booking flow) */
  bare?: boolean;
}
const { title, description, path, noindex, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0e1c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {/* Mark JS available before first paint so scroll-reveal can hide-then-animate
        without a flash. No-JS users never get the .js class and see all content. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO title={title} description={description} path={path} noindex={noindex} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    {!bare && (
      <button
        id="scroll-top"
        class="fixed bottom-5 right-5 z-40 grid h-12 w-12 translate-y-4 place-items-center rounded-full border border-white/10 bg-navy-800/90 text-cream opacity-0 shadow-lg shadow-black/40 backdrop-blur-md transition-all duration-300 hover:border-teal/50 hover:text-teal-bright"
        aria-label="Scroll back to top"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
      </button>
    )}

    <script>
      // Scroll-to-top button: appears after scrolling down a bit.
      const topBtn = document.getElementById('scroll-top');
      if (topBtn) {
        const toggleTopBtn = () => {
          const show = window.scrollY > 600;
          topBtn.classList.toggle('opacity-0', !show);
          topBtn.classList.toggle('translate-y-4', !show);
          topBtn.classList.toggle('pointer-events-none', !show);
        };
        toggleTopBtn();
        window.addEventListener('scroll', toggleTopBtn, { passive: true });
        topBtn.addEventListener('click', () =>
          window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
        );
      }
    </script>

    <script>
      // Scroll-reveal via IntersectionObserver (respects reduced-motion CSS).
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px 12% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
