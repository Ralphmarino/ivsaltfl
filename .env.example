# ------------------------------------------------------------------ #
#  IV Salt Rejuvenation — environment variables
#  Copy to `.env` for local dev, and add these in the Netlify dashboard
#  (Site settings → Environment variables) for production.
#  NEVER commit real values. Only `.env.example` is tracked in git.
# ------------------------------------------------------------------ #

# --- Site ---------------------------------------------------------- #
SITE_URL=https://ivsaltfl.com
OWNER_EMAIL=ivsaltfl@gmail.com
CONSENT_FORM_URL=https://form.jotform.com/261876510047155

# --- Email (Resend) — REQUIRED for booking notifications ----------- #
# Get a key at https://resend.com (free tier). Verify the ivsaltfl.com
# domain, then use an address on it for FROM_EMAIL.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=IV Salt Rejuvenation <bookings@ivsaltfl.com>

# --- Google Calendar (service account) — optional ------------------ #
# Create a service account in Google Cloud, enable the Calendar API,
# then SHARE the target calendar with the service account email
# (Make changes to events). Paste the private key with real newlines
# escaped as \n on a single line, wrapped in quotes.
GOOGLE_CLIENT_EMAIL=iv-salt-booking@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII…\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=ivsaltfl@gmail.com
CALENDAR_TIMEZONE=America/New_York

# --- SMS (Twilio) — optional, pre-wired ---------------------------- #
# Add these later to turn on real text alerts to Sara + the customer.
# Until then, Google Calendar app notifications ping Sara's phone.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1XXXXXXXXXX
SARA_PHONE=+17722227108
